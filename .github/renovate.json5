{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // helpers:pinGitHubActionDigests: workflow `uses:` are pinned to commit SHAs
  // (a tag can be moved to malicious code); Renovate keeps the SHAs current.
  extends: ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],

  // Renovate opens PRs; it never merges on its own. Merging happens only after
  // the owner approves a PR (in the GitHub UI, or from Telegram through
  // openclaw), at which point .github/workflows/renovate-approved.yaml enables
  // auto-merge and GitHub merges once `validate` passes.
  automerge: false,

  // Wait 7 days after a release before proposing it: day-0 releases broke
  // things this week (openclaw 2026.7.35, paperless 3.0.1's bad migration) and
  // upstream usually ships the fix within days. Registries that publish no
  // release timestamp would otherwise never update; timestamp-optional lets
  // those through rather than silently freezing them.
  minimumReleaseAge: "7 days",
  minimumReleaseAgeBehaviour: "timestamp-optional",

  timezone: "America/Los_Angeles",
  // Run overnight so the openclaw digest at 07:00 sees a settled set of PRs.
  schedule: ["before 6am"],
  prConcurrentLimit: 15,
  prHourlyLimit: 0,
  labels: ["renovate"],
  dependencyDashboard: true,

  ignorePaths: [
    "**/.claude/**",
    "clusters/_archive/**",
    // Overlays for retired clusters; only the-intersect is reconciled.
    "**/libvirt-unraid/**",
    "**/solar-pi/**",
    "**/values.example.yaml",
  ],

  flux: {
    // Default only scans gotk-components.yaml. HelmRelease/HelmRepository/
    // OCIRepository live throughout apps/ and infrastructure/.
    managerFilePatterns: ["/(^|/)(apps|infrastructure|clusters)/.+\\.ya?ml$/"],
  },
  kubernetes: {
    // Default is empty; raw Deployment/StatefulSet/Sandbox image: lines.
    managerFilePatterns: ["/(^|/)(apps|infrastructure)/.+\\.ya?ml$/"],
  },
  "helm-values": {
    // values.yaml files fed to HelmReleases through configMapGenerator.
    managerFilePatterns: ["/(^|/)values[^/]*\\.ya?ml$/"],
  },

  // CI tool binaries pinned in workflow env blocks (gitleaks, zizmor, trivy).
  // Each is a `# renovate:` comment, then <TOOL>_VERSION (the release tag) and
  // <TOOL>_SHA256. The github-release-attachments datasource updates BOTH: it
  // finds the asset matching the current checksum and returns the new
  // release's checksum for the same asset, so a bump never leaves a stale
  // checksum (which would fail the now-required checks).
  customManagers: [
    {
      customType: "regex",
      description: "CI tool binaries (version + sha256) in GitHub workflows",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z0-9_]+_VERSION:\\s*(?<currentValue>\\S+)\\s*\\n\\s*[A-Z0-9_]+_SHA256:\\s*(?<currentDigest>[a-f0-9]{64})",
      ],
    },
  ],

  packageRules: [
    {
      // Don't rewrite apiVersions: a newer API (e.g. OCIRepository v1) may not
      // exist in the Flux/Kubernetes version actually running.
      matchDatasources: ["kubernetes-api"],
      enabled: false,
    },
    {
      // gotk-components.yaml is regenerated as a whole by the flux manager
      // (dep fluxcd/flux2). Don't also bump its controller images one by one.
      matchFileNames: ["clusters/**/flux-system/gotk-components.yaml"],
      matchManagers: ["kubernetes"],
      enabled: false,
    },
    {
      // Risk labels drive the openclaw digest: risk/low may be approved in a
      // batch, risk/high is always called out individually with its changelog.
      // `labels` (not addLabels) so a later rule replaces an earlier one: an
      // infra patch ends up risk/high only, not risk/low + risk/high.
      matchUpdateTypes: ["patch", "digest", "pin", "pinDigest"],
      labels: ["renovate", "risk/low"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["renovate", "risk/medium"],
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["renovate", "risk/high"],
    },
    {
      // Cluster plumbing: a bad upgrade here takes out networking, storage,
      // admission, certificates, or GitOps itself -- high risk at any size.
      matchDepNames: [
        "fluxcd/flux2",
        "cilium",
        "rook-ceph",
        "rook-ceph-cluster",
        "quay.io/ceph/ceph",
        "kyverno",
        "cert-manager",
        "csi-driver-nfs",
        "csi-driver-smb",
        "ghcr.io/cloudnative-pg/cloudnative-pg",
        "ghcr.io/k8snetworkplumbingwg/multus-cni",
        "registry.k8s.io/agent-sandbox/agent-sandbox-controller",
      ],
      labels: ["renovate", "risk/high"],
      // One PR per minor version for infrastructure: Rook (and others) only
      // support upgrading one minor at a time, and #243 jumped rook-ceph
      // 1.17 -> 1.20 in a single PR, which skipped Rook 1.18's CSI migration.
      separateMultipleMinor: true,
    },
    {
      // HOLD: operator.yaml is a hand-copied release manifest; bumping only
      // the image left v1.7.0 without the RBAC it needs (cache sync timeout on
      // Pods, CrashLoopBackOff, #167 -> reverted). Upgrade by regenerating the
      // manifest from the release, then lift this.
      matchDepNames: ["docker.dragonflydb.io/dragonflydb/operator"],
      allowedVersions: "<1.2.0",
    },
    {
      // HOLD: chart 0.11+ changed the values schema (persistence keys), so the
      // 0.13.2 upgrade failed validation (#172 -> reverted). Migrate
      // apps/immich values to the new schema, then lift this.
      matchDepNames: ["ghcr.io/immich-app/immich-charts/immich"],
      allowedVersions: "<0.11.0",
    },
    {
      // HOLD: operator.yaml is a hand-copied release manifest; bumping only
      // the image left 1.30.1 without its new CRDs ("no matches for kind
      // DatabaseRole in version postgresql.cnpg.io/v1", CrashLoopBackOff, #170
      // -> reverted). Upgrade by regenerating the manifest (CRDs + RBAC) from
      // the release, one minor at a time, then lift this.
      matchDepNames: ["ghcr.io/cloudnative-pg/cloudnative-pg"],
      allowedVersions: "<1.26.0",
    },
    {
      // HOLD: lfprocks/racadm tags are parallel OpenManage variants, not
      // successive releases. 9.5.0 is the line that supports iDRAC7 (olympic,
      // fw 2.65.65.65); 11.0.1 targets iDRAC9 (#252, closed).
      matchDepNames: ["ghcr.io/lfprocks/racadm"],
      allowedVersions: "<10",
    },
    {
      // Postgres images back live databases (immich, cloudnative-pg clusters);
      // a major is a data migration, not an upgrade.
      matchDepNames: ["/postgres/"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // Invidious publishes date-sha tags (2026.09.30-1454ead) that default
      // docker versioning can't order.
      matchDepNames: ["quay.io/invidious/invidious"],
      versioning: "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})-[0-9a-f]+$",
    },
    {
      // docker.getoutline.com is a vanity host that 302s to Docker Hub, which
      // Renovate's lookup doesn't follow. Look the tags up on Docker Hub; the
      // image reference in the manifests stays as-is.
      matchDepNames: ["docker.getoutline.com/outlinewiki/outline"],
      overridePackageName: "outlinewiki/outline",
    },
    {
      // Rook's operator and cluster charts are released together and should
      // stay on the same version.
      matchDepNames: ["rook-ceph", "rook-ceph-cluster"],
      groupName: "rook-ceph",
    },
    {
      // ARC requires the controller and runner scale set charts to match.
      matchDepNames: ["gha-runner-scale-set-controller", "gha-runner-scale-set"],
      groupName: "actions-runner-controller",
    },
    {
      matchDepNames: ["busybox", "docker.io/library/busybox"],
      groupName: "busybox",
    },
    {
      // openclaw runs as an agent-sandbox Sandbox: merging a bump does not
      // roll the pod. See apps/openclaw/the-intersect/README.md.
      matchDepNames: ["ghcr.io/openclaw/openclaw"],
      // HOLD: 2026.8+ can't run in this Sandbox yet. DuckDuckGo search became
      // a plugin (installs fail as non-root), and 2026.9.x's state migration
      // needs a no-replace rename gVisor doesn't support, so the gateway
      // refuses to start. See #197, #210-#212. Lift once both are solved.
      // 2026.7.35 also fails: its startup migration refuses to report ready
      // because the bundled "signal" plugin's install dir is missing (#232,
      // reverted). Pinned to the last known-good release.
      allowedVersions: "<=2026.7.1",
      prBodyNotes: [
        "⚠️ Merging does not restart openclaw. After Flux reconciles, regenerate it: `kubectl -n openclaw delete sandbox openclaw`.",
      ],
    },
  ],
}
