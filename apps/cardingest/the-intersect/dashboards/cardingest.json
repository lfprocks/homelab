{
  "uid": "cardingest",
  "title": "cardingest",
  "tags": [
    "cardingest",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Camera-card and field-drive ingest (apps/cardingest). Provisioned from git; edits in the UI are not kept.",
  "panels": [
    {
      "id": 1,
      "title": "Pod up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max(up{namespace=\"cardingest\", service=\"cardingest\"})",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Open conflicts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max(cardingest_conflicts_open)",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Conflicts waiting for review in the dashboard's Conflicts view."
    },
    {
      "id": 3,
      "title": "Notifier build errors",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max(cardingest_notifier_build_errors)",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Notifiers that failed to build at startup. Above 0 means push notifications are off."
    },
    {
      "id": 4,
      "title": "Time since last successful job",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "time() - max by (kind) (cardingest_job_last_success_seconds)",
          "range": false,
          "instant": true,
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Appears after the first successful job of each kind."
    },
    {
      "id": 5,
      "title": "Slot states",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max by (slot, state) (cardingest_slot_state) == 1",
          "range": true,
          "instant": false,
          "legendFormat": "{{slot}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "One row per slot/state; a bar shows when the slot was in that state."
    },
    {
      "id": 6,
      "title": "Current slot state",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max by (slot, state) (cardingest_slot_state) == 1",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Jobs by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "sum by (kind, outcome) (increase(cardingest_jobs_total[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Bytes copied rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "sum by (kind) (rate(cardingest_copied_bytes_total[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Copy throughput p50 / p95 by backend",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, backend) (rate(cardingest_copy_throughput_bytes_per_second_bucket[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "p50 {{backend}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(cardingest_copy_throughput_bytes_per_second_bucket[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "p95 {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Per-job copy+verify throughput. kernel = vfat in-kernel, fuse = exFAT through FUSE."
    },
    {
      "id": 10,
      "title": "Job duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(cardingest_job_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "p95 {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Files by action",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "sum by (action) (increase(cardingest_files_total[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
