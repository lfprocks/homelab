{
  "uid": "neuralmarket",
  "title": "neuralmarket",
  "tags": [
    "neuralmarket",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "description": "Pipeline progress, extraction throughput and the database (apps/neuralmarket). Provisioned from git; edits in the UI are not kept.",
  "panels": [
    {
      "id": 1,
      "title": "Done",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max by (stage) (neuralmarket_items_done{job=\"neuralmarket\"}) / max by (stage) (neuralmarket_items_total{job=\"neuralmarket\"})",
          "legendFormat": "{{stage}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {},
      "description": "Finished items over selected items, per running stage. Download reports a count only."
    },
    {
      "id": 2,
      "title": "Remaining items",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max by (stage) (neuralmarket_items_total{job=\"neuralmarket\"}) - max by (stage) (neuralmarket_items_done{job=\"neuralmarket\"})",
          "legendFormat": "{{stage}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Items left in each running stage."
    },
    {
      "id": 3,
      "title": "Time left",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "(max by (stage) (neuralmarket_items_total{job=\"neuralmarket\"}) - max by (stage) (neuralmarket_items_done{job=\"neuralmarket\"})) / (sum by (stage) (rate(neuralmarket_items_processed_total{job=\"neuralmarket\",result=\"ok\"}[30m])) > 0)",
          "legendFormat": "{{stage}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Remaining items at the rate of the last 30 minutes. Empty when nothing finished in that time."
    },
    {
      "id": 4,
      "title": "Items finished",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max by (stage) (neuralmarket_items_done{job=\"neuralmarket\"})",
          "legendFormat": "{{stage}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Running total, including work from before a restart."
    },
    {
      "id": 5,
      "title": "Items per hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "sum by (stage) (rate(neuralmarket_items_processed_total{job=\"neuralmarket\",result=\"ok\"}[30m])) * 3600",
          "legendFormat": "{{stage}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Finished items per hour over 30 minutes."
    },
    {
      "id": 6,
      "title": "Failures and skips (30m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "sum by (stage, result) (increase(neuralmarket_items_processed_total{job=\"neuralmarket\",result!=\"ok\"}[30m]))",
          "legendFormat": "{{stage}} {{result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Failed and skipped items. Chunk and embed skip files that already exist."
    },
    {
      "id": 7,
      "title": "Requests in flight",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "sum(neuralmarket_llm_inflight{job=\"neuralmarket\"})",
          "legendFormat": "in flight",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10
        },
        "overrides": []
      },
      "options": {},
      "description": "The Spark serves eight at a time."
    },
    {
      "id": 8,
      "title": "Tokens per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "sum by (direction) (rate(neuralmarket_llm_tokens_total{job=\"neuralmarket\"}[15m]))",
          "legendFormat": "{{direction}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Counted when a reply arrives, so it is lumpy."
    },
    {
      "id": 9,
      "title": "Request duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(neuralmarket_llm_duration_seconds_bucket{job=\"neuralmarket\"}[30m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(neuralmarket_llm_duration_seconds_bucket{job=\"neuralmarket\"}[30m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Time for one extraction reply."
    },
    {
      "id": 10,
      "title": "Job pods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "sum by (phase) (kube_pod_status_phase{namespace=\"neuralmarket\",pod!~\"neuralmarket-postgres.*\"}) > 0",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "Phases of the pipeline pods."
    },
    {
      "id": 11,
      "title": "Database size",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "max(cnpg_pg_database_size_bytes{datname=\"neuralmarket\"})",
          "legendFormat": "neuralmarket",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "description": "Size of the neuralmarket database."
    },
    {
      "id": 12,
      "title": "Backup age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "editorMode": "code",
          "expr": "time() - max(cnpg_collector_last_available_backup_timestamp{namespace=\"neuralmarket\"} > 0)",
          "legendFormat": "age",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100000
              },
              {
                "color": "red",
                "value": 180000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Time since the last available backup. Daily; empty before the first one."
    }
  ]
}
